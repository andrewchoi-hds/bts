// BTS (Build Team Service) Database Schema
// PostgreSQL on AWS RDS

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// User & Authentication
// ============================================

model User {
  id            String    @id @default(cuid())
  username      String    @unique  // 로그인 ID
  email         String?   // 선택사항
  name          String?
  password      String    // hashed password
  image         String?
  role          String    @default("user")  // 'user' | 'admin'
  isActive      Boolean   @default(true)    // 활성화 상태
  memo          String?   // 관리자 비고
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts      Account[]
  sessions      AuthSession[]
  teamSessions  TeamSession[]
  apiUsageLogs  APIUsageLog[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model AuthSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// BTS Team Session
// ============================================

model TeamSession {
  id        String   @id @default(cuid())
  userId    String
  goal      String
  status    String   @default("active") // active, completed, archived
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  members      TeamMember[]
  messages     Message[]
  documents    Document[]
  apiUsageLogs APIUsageLog[]

  @@map("team_sessions")
}

model TeamMember {
  id        String   @id @default(cuid())
  sessionId String
  name      String
  role      String   // planner, designer, developer, qa, marketer, analyst
  level     String   // junior, senior
  model     String   // gemini, gpt, claude
  persona   Json     // { personality, speakingStyle, perspective, strengths }
  createdAt DateTime @default(now())

  // Relations
  session  TeamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  messages Message[]

  @@map("team_members")
}

model Message {
  id           String   @id @default(cuid())
  sessionId    String
  memberId     String?  // null if system message
  memberName   String
  memberRole   String
  memberLevel  String
  content      String   @db.Text
  round        Int?
  stage        String?  // brainstorm, discussion, review
  createdAt    DateTime @default(now())

  // Relations
  session TeamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  member  TeamMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@map("messages")
}

model Document {
  id        String   @id @default(cuid())
  sessionId String
  version   Int      @default(1)
  content   String   @db.Text
  changes   String?  // description of changes from previous version
  feedback  String?  // user feedback that triggered this version
  createdAt DateTime @default(now())

  // Relations
  session TeamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, version])
  @@map("documents")
}

// ============================================
// API Usage Tracking
// ============================================

model APIUsageLog {
  id               String   @id @default(cuid())
  userId           String
  sessionId        String?
  provider         String   // 'gemini' | 'openai'
  model            String
  endpoint         String   // 'chat' | 'generate' | 'refine'
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  latencyMs        Int?
  success          Boolean  @default(true)
  errorMessage     String?
  createdAt        DateTime @default(now())

  // Relations
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session TeamSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([provider])
  @@map("api_usage_logs")
}
